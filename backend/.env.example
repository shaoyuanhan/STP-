# ===== 智能运输管理平台 (STP) · 数据库连接配置 =====
# 复制本文件为 .env 并按本地 MySQL 实际情况修改
# 也可以不建 .env，直接使用下方默认值对应的本地环境

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=tms_vehicle

# 后端服务端口
PORT=3000

# ===== 承运商端/司机端 =====
JWT_SECRET=stp-portal-local-secret
JWT_EXPIRES_SECONDS=604800
SMS_PROVIDER=mock          # mock | aliyun | tencent（本地用 mock）
WX_PROVIDER=mock           # mock | wechat（本地用 mock）
PICKUP_PHOTO_MIN=4
PORTAL_DEV_TOOLS=1
