{
  "openapi": "3.0.3",
  "info": {
    "title": "智能运输管理平台（STP）API",
    "description": "整车发运业务全流程接口。包含平台业务接口（基础数据/调度/监控/结算/电子签）与外部系统模拟接口（CRM/WMS/狮桥物流/司机端，对应 PRD 系统交互协议）。\n\n**通用约定**：\n- 所有列表接口支持 `page`（默认1）/ `size`（默认10）分页，返回 `{ list, total, page, size }`\n- 业务校验失败返回 `{ \"message\": \"原因\" }` + 400/404/409 状态码\n- 任务状态机：PENDING待派单 → DISPATCHED已派单 → ACCEPTED已接单 → OUT_BOUND已出库/PICKED_UP已提车 → IN_TRANSIT在途 → ARRIVED已到达 → FINISHED已完结 / CANCELLED已取消\n- 编号规则：任务单号 FY+YYYYMMDD+4位序列（按日重置），运费单号 YF+YYYYMMDD+4位序列，承运商编码 CAR+3位序列",
    "version": "1.0.0"
  },
  "servers": [
    { "url": "http://localhost:3000", "description": "本地后端（推荐：项目在本机运行时使用）" },
    { "url": "https://preview.example.com", "description": "演示沙箱（替换为实际预览域名，前端服务器已代理 /api）" }
  ],
  "tags": [
    { "name": "01 通用" },
    { "name": "02 工作台" },
    { "name": "03 承运商管理" },
    { "name": "04 司机管理" },
    { "name": "05 发运任务" },
    { "name": "06 在途监控" },
    { "name": "07 应付运费对账" },
    { "name": "08 电子签台账" },
    { "name": "09 外部接口·CRM" },
    { "name": "10 外部接口·WMS" },
    { "name": "11 外部接口·狮桥物流" },
    { "name": "12 外部接口·司机端同步" }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "tags": ["01 通用"],
        "summary": "健康检查",
        "responses": {
          "200": {
            "description": "服务状态",
            "content": {
              "application/json": {
                "example": { "ok": true, "service": "tms-vehicle-shipping", "time": "2026-10-19T01:19:06.633Z" }
              }
            }
          }
        }
      }
    },
    "/api/stats": {
      "get": {
        "tags": ["02 工作台"],
        "summary": "工作台统计",
        "responses": {
          "200": {
            "description": "任务状态分布 / 承运商司机数 / 运费汇总",
            "content": {
              "application/json": {
                "example": {
                  "task": { "pending": 6, "dispatched": 2, "accepted": 1, "outBound": 1, "pickedUp": 0, "inTransit": 2, "arrived": 1, "finished": 2, "cancelled": 1, "total": 16 },
                  "carriers": 4,
                  "drivers": 7,
                  "freightPending": { "count": 1, "amount": 9600 },
                  "freightMonth": { "count": 3, "amount": 30600 }
                }
              }
            }
          }
        }
      }
    },
    "/api/carriers": {
      "get": {
        "tags": ["03 承运商管理"],
        "summary": "承运商列表",
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "size", "in": "query", "schema": { "type": "integer", "default": 10 } },
          { "name": "keyword", "in": "query", "schema": { "type": "string" }, "description": "名称/联系人/电话模糊查询" },
          { "name": "status", "in": "query", "schema": { "type": "string", "enum": ["COOPERATING", "DISABLED"] } }
        ],
        "responses": {
          "200": {
            "description": "列表 + 在册司机数",
            "content": {
              "application/json": {
                "example": {
                  "list": [{ "id": 1, "carrier_code": "CAR-001", "carrier_name": "狮桥物流股份有限公司", "contact_person": "李强", "contact_phone": "+8613812340001", "coop_routes": "合肥-华东 / 合肥-华中", "status": "COOPERATING", "driver_count": 3 }],
                  "total": 4, "page": 1, "size": 10
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["03 承运商管理"],
        "summary": "新增承运商",
        "description": "编码系统自动生成（CAR+3位序列）；名称去重，重名返回 409",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["carrier_name", "contact_person", "contact_phone"],
                "properties": {
                  "carrier_name": { "type": "string", "description": "承运商名称（唯一）" },
                  "contact_person": { "type": "string" },
                  "contact_phone": { "type": "string" },
                  "coop_routes": { "type": "string", "description": "合作线路" },
                  "remark": { "type": "string" }
                }
              },
              "example": { "carrier_name": "中储智运物流有限公司", "contact_person": "周敏", "contact_phone": "+8613955100011", "coop_routes": "合肥-华北 / 合肥-华东", "remark": "干线运力补充" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "新增成功",
            "content": { "application/json": { "example": { "message": "新增成功", "data": { "id": 5, "carrier_code": "CAR-005", "carrier_name": "中储智运物流有限公司", "status": "COOPERATING" } } } }
          },
          "409": { "description": "名称已存在", "content": { "application/json": { "example": { "message": "承运商名称已存在，请勿重复添加" } } } }
        }
      }
    },
    "/api/carriers/{id}": {
      "put": {
        "tags": ["03 承运商管理"],
        "summary": "编辑承运商",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "type": "object", "required": ["carrier_name", "contact_person", "contact_phone"] },
              "example": { "carrier_name": "狮桥物流股份有限公司", "contact_person": "李强", "contact_phone": "+8613812340001", "coop_routes": "合肥-华东 / 合肥-华南", "remark": "" }
            }
          }
        },
        "responses": {
          "200": { "description": "修改成功", "content": { "application/json": { "example": { "message": "修改成功", "data": {} } } } },
          "404": { "description": "不存在", "content": { "application/json": { "example": { "message": "承运商不存在" } } } }
        }
      }
    },
    "/api/carriers/{id}/status": {
      "put": {
        "tags": ["03 承运商管理"],
        "summary": "承运商启用/停用",
        "description": "停用后不可被派单，不影响在途运单",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "type": "object", "required": ["status"], "properties": { "status": { "type": "string", "enum": ["COOPERATING", "DISABLED"] } } },
              "example": { "status": "DISABLED" }
            }
          }
        },
        "responses": {
          "200": { "description": "成功", "content": { "application/json": { "example": { "message": "已停用，该承运商不可被派单，在途运单不受影响" } } } }
        }
      }
    },
    "/api/drivers": {
      "get": {
        "tags": ["04 司机管理"],
        "summary": "司机列表",
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "size", "in": "query", "schema": { "type": "integer", "default": 10 } },
          { "name": "keyword", "in": "query", "schema": { "type": "string" }, "description": "姓名/手机号/身份证号" },
          { "name": "carrier_id", "in": "query", "schema": { "type": "integer" } },
          { "name": "status", "in": "query", "schema": { "type": "string", "enum": ["ENABLED", "DISABLED"] } }
        ],
        "responses": {
          "200": {
            "description": "列表",
            "content": {
              "application/json": {
                "example": {
                  "list": [{ "id": 2, "name": "刘志强", "phone": "+8613712340002", "id_card": "340102198503150023", "vehicle_type": "重型半挂牵引车", "carrier_id": 1, "carrier_name": "狮桥物流股份有限公司", "status": "ENABLED" }],
                  "total": 8, "page": 1, "size": 10
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["04 司机管理"],
        "summary": "新增司机",
        "description": "身份证号去重（409）；姓名与身份证号创建后不可修改",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name", "phone", "id_card", "license_valid_from", "license_valid_to"],
                "properties": {
                  "name": { "type": "string" },
                  "phone": { "type": "string" },
                  "id_card": { "type": "string", "description": "唯一" },
                  "license_no": { "type": "string" },
                  "vehicle_type": { "type": "string", "description": "准驾车型/车辆类型" },
                  "license_valid_from": { "type": "string", "format": "date" },
                  "license_valid_to": { "type": "string", "format": "date" },
                  "carrier_id": { "type": "integer" },
                  "remark": { "type": "string" }
                }
              },
              "example": { "name": "孙卫东", "phone": "+8613655100009", "id_card": "340103199208120011", "license_no": "B2-340103199208", "vehicle_type": "重型半挂牵引车", "license_valid_from": "2024-06-01", "license_valid_to": "2030-06-01", "carrier_id": 1, "remark": "" }
            }
          }
        },
        "responses": {
          "201": { "description": "新增成功", "content": { "application/json": { "example": { "message": "新增成功", "data": {} } } } },
          "409": { "description": "身份证号已存在", "content": { "application/json": { "example": { "message": "该身份证号已存在，请勿重复添加" } } } }
        }
      }
    },
    "/api/drivers/options": {
      "get": {
        "tags": ["04 司机管理"],
        "summary": "可选司机（启用中）",
        "description": "承运商接单时分配司机用，可按承运商过滤",
        "parameters": [{ "name": "carrier_id", "in": "query", "schema": { "type": "integer" } }],
        "responses": {
          "200": { "description": "启用中司机", "content": { "application/json": { "example": { "list": [{ "id": 2, "name": "刘志强", "phone": "+8613712340002", "vehicle_type": "重型半挂牵引车", "carrier_id": 1, "carrier_name": "狮桥物流股份有限公司" }] } } } }
        }
      }
    },
    "/api/drivers/{id}": {
      "put": {
        "tags": ["04 司机管理"],
        "summary": "编辑司机",
        "description": "姓名与身份证号不可修改",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "type": "object", "required": ["phone", "license_valid_from", "license_valid_to"] },
              "example": { "phone": "+8613712340002", "license_no": "B2-340102198503", "vehicle_type": "重型半挂牵引车", "license_valid_from": "2024-06-01", "license_valid_to": "2030-06-01", "carrier_id": 1, "remark": "" }
            }
          }
        },
        "responses": {
          "200": { "description": "成功", "content": { "application/json": { "example": { "message": "修改成功（姓名与身份证号不可修改）", "data": {} } } } }
        }
      }
    },
    "/api/drivers/{id}/status": {
      "put": {
        "tags": ["04 司机管理"],
        "summary": "司机启用/停用",
        "description": "停用后不可再分派任务，不影响在途运单",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "type": "object", "required": ["status"], "properties": { "status": { "type": "string", "enum": ["ENABLED", "DISABLED"] } } },
              "example": { "status": "DISABLED" }
            }
          }
        },
        "responses": {
          "200": { "description": "成功", "content": { "application/json": { "example": { "message": "已停用，该司机不可再被分派任务，在途运单不受影响" } } } }
        }
      }
    },
    "/api/ship-tasks": {
      "get": {
        "tags": ["05 发运任务"],
        "summary": "任务列表（多条件筛选）",
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "size", "in": "query", "schema": { "type": "integer", "default": 10 } },
          { "name": "task_no", "in": "query", "schema": { "type": "string" }, "description": "任务单号" },
          { "name": "apply_no", "in": "query", "schema": { "type": "string" }, "description": "CRM发运申请号" },
          { "name": "vin", "in": "query", "schema": { "type": "string" } },
          { "name": "customer_name", "in": "query", "schema": { "type": "string" } },
          { "name": "status", "in": "query", "schema": { "type": "string", "enum": ["PENDING", "DISPATCHED", "ACCEPTED", "OUT_BOUND", "PICKED_UP", "IN_TRANSIT", "ARRIVED", "FINISHED", "CANCELLED"] } },
          { "name": "carrier_id", "in": "query", "schema": { "type": "integer" } },
          { "name": "start_date", "in": "query", "schema": { "type": "string", "format": "date" }, "description": "创建日期起" },
          { "name": "end_date", "in": "query", "schema": { "type": "string", "format": "date" }, "description": "创建日期止" }
        ],
        "responses": {
          "200": { "description": "列表", "content": { "application/json": { "example": { "list": [{ "id": 17, "task_no": "FY202610190001", "apply_no": "APITEST1792372773155", "customer_name": "联测物流科技（上海）有限公司", "vin": "LZXBCGH49P1D10099", "vehicle_model": "星辰重卡 H9-460", "origin": "合肥市包河区上海路88号", "dest_region": "上海市", "plan_freight": 9800, "status": "PENDING", "carrier_name": null, "driver_name": null }], "total": 18, "page": 1, "size": 10 } } } }
        }
      }
    },
    "/api/ship-tasks/{id}": {
      "get": {
        "tags": ["05 发运任务"],
        "summary": "任务详情",
        "description": "返回 task + events（节点时间轴）+ trackings（位置记录）+ esigns（电子签）",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": {
          "200": {
            "description": "详情",
            "content": {
              "application/json": {
                "example": {
                  "task": { "id": 17, "task_no": "FY202610190001", "status": "IN_TRANSIT", "carrier_name": "狮桥物流股份有限公司", "driver_name": "刘志强" },
                  "events": [{ "id": 130, "node": "APPLY", "node_name": "CRM下发发运申请", "detail": "接收CRM发运申请 APITEST1792372773155，计划运费 9800.00 元", "operator": "CRM系统", "created_at": "2026-10-19 09:19:19" }],
                  "trackings": [{ "transport_no": "SQ202610190017", "position_desc": "南京市 G42沪蓉高速", "speed": 71, "reported_at": "2026-10-19 09:19:20" }],
                  "esigns": [{ "esign_id": "ES-APITEST-1792372773000", "sign_type": "物流电子签", "status": "SIGNED" }]
                }
              }
            }
          },
          "404": { "description": "不存在", "content": { "application/json": { "example": { "message": "任务不存在" } } } }
        }
      }
    },
    "/api/ship-tasks/{id}/dispatch": {
      "post": {
        "tags": ["05 发运任务"],
        "summary": "派单",
        "description": "仅 PENDING 可派单；承运商须为合作中（COOPERATING）。线路参考价取自 CRM 计划运费，派单时不可修改；remark 为调度派单备注，随任务保存并在时间轴留痕",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" }, "description": "任务ID" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "type": "object", "required": ["carrier_id"], "properties": { "carrier_id": { "type": "integer" }, "remark": { "type": "string", "maxLength": 500, "description": "派单备注（调度说明，选填）" } } },
              "example": { "carrier_id": 1, "remark": "加急发运，优先安排" }
            }
          }
        },
        "responses": {
          "200": { "description": "派单成功", "content": { "application/json": { "example": { "message": "派单成功，已同步狮桥发运系统", "carrier_name": "狮桥物流股份有限公司" } } } },
          "400": { "description": "状态不允许", "content": { "application/json": { "example": { "message": "仅\"待派单\"状态的任务可以派单" } } } }
        }
      }
    },
    "/api/ship-tasks/dispatch-batch": {
      "post": {
        "tags": ["05 发运任务"],
        "summary": "批量派单",
        "description": "仅 PENDING 任务会被派单，非待派单自动跳过",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "type": "object", "required": ["task_ids", "carrier_id"], "properties": { "task_ids": { "type": "array", "items": { "type": "integer" } }, "carrier_id": { "type": "integer" } } },
              "example": { "task_ids": [21, 22, 23], "carrier_id": 1 }
            }
          }
        },
        "responses": {
          "200": { "description": "批量结果", "content": { "application/json": { "example": { "message": "批量派单完成：成功 3 单" } } } }
        }
      }
    },
    "/api/ship-tasks/{id}/cancel-dispatch": {
      "post": {
        "tags": ["05 发运任务"],
        "summary": "取消派单",
        "description": "仅已派单且司机未接单可取消，任务回到待派单；取消原因枚举：承运商无法履约/调度调整/其他，remark 为补充说明，与原因一并留痕",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "type": "object", "properties": { "reason": { "type": "string", "enum": ["承运商无法履约", "调度调整", "其他"] }, "remark": { "type": "string", "maxLength": 500, "description": "补充说明（选填）" } } },
              "example": { "reason": "承运商无法履约", "remark": "车辆临时检修无法执行本趟运输" }
            }
          }
        },
        "responses": {
          "200": { "description": "取消成功", "content": { "application/json": { "example": { "message": "已取消派单，任务回到待派单，并同步三方物流系统" } } } }
        }
      }
    },
    "/api/ship-tasks/{id}/reassign": {
      "post": {
        "tags": ["05 发运任务"],
        "summary": "改派",
        "description": "仅 DISPATCHED 可改派，新承运商须与原承运商不同；remark 传入则覆盖原派单备注，不传则保留",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "type": "object", "required": ["carrier_id"], "properties": { "carrier_id": { "type": "integer" }, "remark": { "type": "string", "maxLength": 500, "description": "改派后的派单备注（选填）" } } },
              "example": { "carrier_id": 2, "remark": "原承运商运力不足，改派" }
            }
          }
        },
        "responses": {
          "200": { "description": "改派成功", "content": { "application/json": { "example": { "message": "改派成功：XX物流有限公司，原派单已同步三方物流系统取消" } } } }
        }
      }
    },
    "/api/tracking": {
      "get": {
        "tags": ["06 在途监控"],
        "summary": "在途运单列表",
        "description": "仅展示未完结运单（PENDING~ARRIVED），在途优先排序，附带最新位置",
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "size", "in": "query", "schema": { "type": "integer", "default": 10 } },
          { "name": "task_no", "in": "query", "schema": { "type": "string" } },
          { "name": "transport_no", "in": "query", "schema": { "type": "string" }, "description": "运输单号" }
        ],
        "responses": {
          "200": {
            "description": "列表（含最新位置）",
            "content": {
              "application/json": {
                "example": {
