          }
        },
        "responses": {
          "200": { "description": "完结成功", "content": { "application/json": { "example": { "message": "任务已完结" } } } }
        }
      }
    },
    "/api/mock/esign/status": {
      "post": {
        "tags": ["11 外部接口·狮桥物流"],
        "summary": "接口14 · 狮桥电子签状态回传",
        "description": "回传签署完成或取消，仅待签署状态可变更",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "type": "object", "required": ["esign_id", "status"], "properties": { "esign_id": { "type": "string" }, "status": { "type": "string", "enum": ["SIGNED", "CANCELLED"] } } },
              "example": { "esign_id": "ES-20261019-0001", "status": "SIGNED" }
            }
          }
        },
        "responses": {
          "200": { "description": "成功", "content": { "application/json": { "example": { "message": "签署完成" } } } },
          "400": { "description": "状态不允许", "content": { "application/json": { "example": { "message": "该电子签当前状态为【SIGNED】，不可变更" } } } }
        }
      }
    },
    "/api/mock/esign/sign-task": {
      "post": {
        "tags": ["11 外部接口·狮桥物流"],
        "summary": "辅助 · 按发运申请号签收电子签",
        "description": "演示辅助：签收指定任务当前待签署的最新电子签（等价于对该任务调用接口14 SIGNED）。按发运申请号 apply_no 定位任务（推荐），兼容传任务单号 task_no",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "type": "object", "required": ["apply_no"], "properties": { "apply_no": { "type": "string", "description": "CRM 发运申请号（推荐定位键）" }, "task_no": { "type": "string", "description": "任务单号（兼容参数，apply_no 未传时生效）" } } },
              "example": { "apply_no": "CRM-20261019-0001", "task_no": "FY202610190001" }
            }
          }
        },
        "responses": {
          "200": { "description": "签收成功", "content": { "application/json": { "example": { "message": "电子签 ES-20261019-0001 签署完成" } } } },
          "400": { "description": "无待签署电子签", "content": { "application/json": { "example": { "message": "该任务无待签署的电子签" } } } }
        }
      }
    },
    "/api/mock/driver/sync": {
      "post": {
        "tags": ["12 外部接口·司机端同步"],
        "summary": "接口10 · 司机信息三方同步",
        "description": "按身份证号幂等：不存在则新增（ENABLED），存在则更新姓名/电话/驾驶证/归属承运商",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name", "phone", "id_card"],
                "properties": {
                  "name": { "type": "string" },
                  "phone": { "type": "string" },
                  "id_card": { "type": "string", "description": "身份证号（幂等键）" },
                  "license_no": { "type": "string" },
                  "vehicle_type": { "type": "string" },
                  "license_valid_from": { "type": "string", "format": "date" },
                  "license_valid_to": { "type": "string", "format": "date" },
                  "carrier_id": { "type": "integer" }
                }
              },
              "example": { "name": "赵联测", "phone": "+8613705519999", "id_card": "340102199001011234", "license_no": "B2-3401021990", "vehicle_type": "重型半挂牵引车", "license_valid_from": "2024-06-01", "license_valid_to": "2030-06-01", "carrier_id": 1 }
            }
          }
        },
        "responses": {
          "201": { "description": "新增", "content": { "application/json": { "example": { "message": "司机已同步新增", "id": 9 } } } },
          "200": { "description": "更新（幂等命中）", "content": { "application/json": { "example": { "message": "司机信息已更新", "id": 2 } } } }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BizError": {
        "type": "object",
        "properties": { "message": { "type": "string" } },
        "description": "统一业务错误"
      }
    }
  }
}
